# API key (for OpenAI-compatible or Gemini API)
LLM_API_KEY=your_api_key_here

# Optional base URL (for OpenAI-compatible endpoints like local ollama or proxies)
LLM_BASE_URL=

# Model name (e.g. gemini-flash-lite-latest, gemini-3.5-flash, gpt-4o)
LLM_MODEL=gemini-flash-lite-latest

# Run tests without spending tokens
MOCK_MODE=true

# Self-correction loop retries
MAX_RETRIES=3

# Logging level
LOG_LEVEL=INFO
